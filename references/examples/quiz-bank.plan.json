          "title": "מה נשמר ב-commit",
          "choices": {
            "kind": "quiz",
            "prompt": "מה נשמר ב-commit?",
            "options": [
              {
                "id": "a",
                "text": "רק הקבצים ששונו מאז ה-commit הקודם"
              },
              {
                "id": "b",
                "text": "צילום מצב של כל הקבצים במאגר"
              },
              {
                "id": "c",
                "text": "רק הודעת ה-commit"
              }
            ],
            "correct": "b"
          },
          "fields": [
            {
              "key": "explanation",
              "label": "Explanation",
              "value": "Git שומר צילום מצב של כל הקבצים. קובץ שלא השתנה נשמר כהפניה לגרסה הקודמת."
            }
          ]
        },
        {
          "id": "qz-02",
          "kind": "quiz",
          "title": "אזור ההכנה",
          "choices": {
            "kind": "quiz",
            "prompt": "איזו פקודה מעבירה קובץ לאזור ההכנה?",
            "options": [
              {
                "id": "a",
                "text": "`git commit`"
              },
              {
                "id": "b",
                "text": "`git add`"
              },
              {
                "id": "c",
                "text": "`git push`"
              }
            ],
            "correct": "b"
          },
          "fields": [
            {
              "key": "explanation",
              "label": "Explanation",
              "value": "`git add` מעביר את הקובץ לאזור ההכנה. `git commit` שומר את מה שנמצא שם."
            }
          ]
        }
      ]
    },
